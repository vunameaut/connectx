# ConnectX — Environment Variables Template
# Copy this file to .env for local development. Never commit real secrets to version control.

# ==============================================================================
# 1. MOBILE APP PUBLIC CONFIGURATION (apps/mobile)
# Safe to bundle in client binary. NEVER put private service keys here.
# ==============================================================================

# Backend API & Signaling
CONNECTX_API_BASE_URL="http://10.0.2.2:4000"         # 10.0.2.2 for Android Emulator, localhost for iOS simulator
CONNECTX_SIGNALING_WS_URL="ws://10.0.2.2:4001"

# Firebase Client SDK Configuration (Get from Firebase Console -> Project Settings -> General)
CONNECTX_FIREBASE_API_KEY="AIzaSyBYCfQb97FKnn0oFZTQaroy3ff7aS03FUE"
CONNECTX_FIREBASE_AUTH_DOMAIN="message-62553.firebaseapp.com"
CONNECTX_FIREBASE_PROJECT_ID="message-62553"
CONNECTX_FIREBASE_STORAGE_BUCKET="message-62553.firebasestorage.app"
CONNECTX_FIREBASE_MESSAGING_SENDER_ID="410097638269"
CONNECTX_FIREBASE_APP_ID="1:410097638269:android:d93b3198b83732b44a8a14"

# Supabase Client Configuration
CONNECTX_SUPABASE_URL="https://your-project.supabase.co"
CONNECTX_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_ANON_KEY"

# Cloudinary Client Configuration (Public Cloud Name only)
CONNECTX_CLOUDINARY_CLOUD_NAME="connectx-cloud"

# WebRTC STUN/TURN Public URLs (Short-lived TURN credentials issued by trusted API)
CONNECTX_WEBRTC_STUN_SERVER="stun:stun.l.google.com:19302"


# ==============================================================================
# 2. TRUSTED SERVER CONFIGURATION (services/api & services/signaling)
# STRICTLY CONFIDENTIAL. Never expose to mobile client or client bundles.
# ==============================================================================

# Server Network
API_PORT="4000"
API_HOST="0.0.0.0"
SIGNALING_PORT="4001"
SIGNALING_HOST="0.0.0.0"

# Firebase Admin SDK (Path to service account JSON or encoded JSON string)
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/message-62553-firebase-adminsdk-fbsvc-1a7a2c6deb.json"
FIREBASE_PROJECT_ID="message-62553"

# Supabase Server Secrets (Used ONLY by trusted API for token minting and schema migrations)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PLACEHOLDER_SERVICE_ROLE"
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters"

# Cloudinary Server Secrets (Used ONLY for signing client upload requests)
CLOUDINARY_CLOUD_NAME="connectx-cloud"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret-placeholder"

# TURN / Coturn Server Secrets for generating time-limited ephemeral ICE credentials
TURN_SECRET="your-coturn-auth-secret-here"
TURN_SERVERS="turn:turn.connectx.app:3478"
