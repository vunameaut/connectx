<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="16dp"
    android:background="?android:attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <TextView
            android:id="@+id/tvContactAvatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_card_secondary"
            android:text="B"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_status_online" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/tvContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trần Thị B"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvContactEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="b.tran@example.com"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Quick Action: Chat -->
    <ImageView
        android:id="@+id/btnQuickChat"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:background="@drawable/bg_card_rounded"
        android:src="@drawable/ic_chat"
        app:tint="@color/colorPrimaryLight"
        android:contentDescription="Nhắn tin" />

    <!-- Quick Action: Call -->
    <ImageView
        android:id="@+id/btnQuickCall"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_card_rounded"
        android:src="@drawable/ic_calls"
        app:tint="@color/status_online"
        android:contentDescription="Gọi điện" />

    <!-- Action: Delete Contact -->
    <ImageView
        android:id="@+id/btnDeleteContact"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:padding="8dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_card_rounded"
        android:src="@drawable/ic_delete"
        app:tint="@color/call_red"
        android:contentDescription="Xóa bạn bè" />

</LinearLayout>
