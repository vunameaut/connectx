<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060912">

    <!-- Video / Screen Share View Placeholder -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#060912">

        <!-- Remote WebRTC Video / Screen Share View -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/remoteVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Local Camera PIP Preview -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardLocalVideo"
            android:layout_width="120dp"
            android:layout_height="170dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="100dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:visibility="gone">

            <org.webrtc.SurfaceViewRenderer
                android:id="@+id/localVideoView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </androidx.cardview.widget.CardView>

        <!-- Screen Share Active Banner -->
        <LinearLayout
            android:id="@+id/layoutScreenShareBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D9DC2626"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_screenshare"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvScreenShareBannerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="ĐANG CHIA SẺ MÀN HÌNH (Android 14+ Foreground Service)"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Dedicated Minimalist Fallback Layout for PiP Mode (Voice calls or before remote video connects) -->
    <LinearLayout
        android:id="@+id/layoutPipFallback"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B0F19"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        android:visibility="gone">

        <!-- Compact Avatar -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp">

            <View
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_story_ring" />

            <TextView
                android:id="@+id/tvPipAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:text="U"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center" />
        </FrameLayout>

        <!-- Compact Contact Name -->
        <TextView
            android:id="@+id/tvPipContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn bè"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />

        <!-- Live Call Timer with Online Pulse Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_online" />

            <TextView
                android:id="@+id/tvPipTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Minimize / Back to PiP Button (Như Messenger / Zalo) -->
    <ImageButton
        android:id="@+id/btnMinimizeCall"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_card_rounded"
        android:src="@drawable/ic_minimize_call"
        app:tint="@color/white"
        android:padding="8dp"
        android:elevation="6dp"
        android:contentDescription="Thu nhỏ cuộc gọi" />

    <!-- Top Call Quality Badge -->
    <LinearLayout
        android:id="@+id/layoutCallQualityBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_badge"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_status_online" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="HD 1080p • WebRTC E2E • Metered TURN"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Caller / Callee Info (Avatar with Radar Ring) -->
    <LinearLayout
        android:id="@+id/callHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">

            <!-- Gradient Aura Ring -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_story_ring" />

            <TextView
                android:id="@+id/tvCallAvatar"
                android:layout_width="106dp"
                android:layout_height="106dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_avatar_circle"
                android:text="B"
                android:textColor="@color/white"
                android:textSize="44sp"
                android:textStyle="bold"
                android:gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCallContactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn bè ConnectX"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đang kết nối WebRTC..."
            android:textColor="@color/colorPrimaryLight"
            android:textSize="15sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#94A3B8"
            android:textSize="15sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- Call Controls Floating Dock at Bottom -->
    <LinearLayout
        android:id="@+id/callControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="44dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_card_rounded"
        android:paddingVertical="18dp"
        android:paddingHorizontal="8dp"
        android:elevation="8dp">

        <!-- Mic Mute Toggle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnToggleMic"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:fabCustomSize="54dp"
                app:srcCompat="@drawable/ic_mic"
                app:tint="@color/white"
                app:backgroundTint="@color/bg_card_secondary"
                app:elevation="2dp"
                android:contentDescription="@string/mute_mic" />

            <TextView
                android:id="@+id/tvMicLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Video Camera Toggle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnToggleVideo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:fabCustomSize="54dp"
                app:srcCompat="@drawable/ic_videocall"
                app:tint="@color/white"
                app:backgroundTint="@color/bg_card_secondary"
                app:elevation="2dp"
                android:contentDescription="@string/turn_off_video" />

            <TextView
                android:id="@+id/tvVideoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camera"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- SCREEN SHARE Toggle (Android 14+ MediaProjection) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnToggleScreenShare"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:fabCustomSize="54dp"
                app:srcCompat="@drawable/ic_screenshare"
                app:tint="@color/white"
                app:backgroundTint="@color/colorPrimary"
                app:elevation="2dp"
                android:contentDescription="@string/screen_share" />

            <TextView
                android:id="@+id/tvScreenShareLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chia sẻ"
                android:textColor="@color/colorPrimaryLight"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- End Call Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnEndCall"
                android:layout_width="54dp"
                android:layout_height="54dp"
                app:fabCustomSize="54dp"
                app:srcCompat="@drawable/ic_call_end"
                app:tint="@color/white"
                app:backgroundTint="@color/call_red"
                app:elevation="4dp"
                android:contentDescription="@string/end_call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kết thúc"
                android:textColor="@color/call_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Incoming Call Floating Action Bar (Nhấc máy / Từ chối như Zalo) -->
    <LinearLayout
        android:id="@+id/layoutIncomingCallActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="48dp"
        android:layout_marginHorizontal="32dp"
        android:visibility="gone">

        <!-- Decline Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDeclineCall"
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:fabCustomSize="68dp"
                app:srcCompat="@drawable/ic_call_end"
                app:tint="@color/white"
                app:backgroundTint="@color/call_red"
                app:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Từ chối"
                android:textColor="@color/call_red"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Accept Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnAcceptCall"
                android:layout_width="68dp"
                android:layout_height="68dp"
                app:fabCustomSize="68dp"
                app:srcCompat="@drawable/ic_calls"
                app:tint="@color/white"
                app:backgroundTint="@color/call_green"
                app:elevation="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhấc máy"
                android:textColor="@color/call_green"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
