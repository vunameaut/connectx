<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:paddingVertical="4dp"
    android:paddingStart="12dp"
    android:paddingEnd="64dp">

    <TextView
        android:id="@+id/tvMessageOtherAvatar"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_card_secondary"
        android:text="B"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_message_other"
        android:layout_marginStart="8dp"
        android:elevation="1dp"
        android:padding="8dp">

        <!-- Attached Image with Rounded Corners -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMessageImageOther"
            android:layout_width="230dp"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:visibility="gone"
            android:layout_marginBottom="6dp">

            <ImageView
                android:id="@+id/ivMessageImageOther"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Hình ảnh đính kèm" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvMessageTextOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xin chào!"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvMessageTimeOther"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="14:33"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
