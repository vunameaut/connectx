<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_dark"
    android:padding="32dp">

    <!-- App Logo Icon -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@drawable/ic_chat"
        app:tint="@color/colorPrimary"
        android:background="@drawable/bg_card_rounded"
        android:padding="16dp"
        android:contentDescription="ConnectX Logo" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ConnectX"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <!-- Slogan -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_slogan"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <View
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <!-- Google Sign-In Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGoogleSignIn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/login_with_google"
        android:textColor="#1F2937"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_google"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@null"
        app:cornerRadius="28dp"
        app:backgroundTint="#FFFFFF"
        android:elevation="4dp" />

    <!-- Guest / Demo Mode Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGuestSignIn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/login_as_guest"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        app:cornerRadius="28dp"
        app:backgroundTint="@color/bg_card_secondary"
        app:strokeColor="@color/divider"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/tvLoginStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:layout_marginTop="24dp"
        android:text="Bảo mật end-to-end • WebRTC &amp; Screen Share" />

    <ProgressBar
        android:id="@+id/pbLoginLoading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="16dp"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone" />

</LinearLayout>
