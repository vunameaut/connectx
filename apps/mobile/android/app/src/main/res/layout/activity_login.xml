<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingVertical="40dp">

        <!-- Top Spacing -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Logo Container with Ambient Glow -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_connectx_logo"
                android:contentDescription="ConnectX Brand Logo" />
        </FrameLayout>

        <!-- Brand Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ConnectX"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.02"
            android:layout_marginTop="16dp" />

        <!-- Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KẾT NỐI KHÔNG GIỚI HẠN"
            android:textColor="@color/colorPrimaryLight"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_badge"
            android:layout_marginTop="8dp" />

        <!-- Slogan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nhắn tin real-time • Gọi thoại &amp; Video WebRTC • Chia sẻ màn hình chuẩn Zalo"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="12dp" />

        <!-- Feature Highlights Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:layout_marginTop="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/colorPrimaryLight" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhắn tin tức thì &amp; Bong bóng chat Zalo"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_videocall"
                    app:tint="@color/status_online" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gọi Video WebRTC HD &amp; TURN Metered"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_screenshare"
                    app:tint="@color/colorIndigo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chia sẻ toàn màn hình Android 14+ bảo mật"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="28dp" />

        <!-- Google Sign-In Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/login_with_google"
            android:textColor="#0F172A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_google"
            app:iconGravity="textStart"
            app:iconPadding="14dp"
            app:iconTint="@null"
            app:cornerRadius="28dp"
            app:backgroundTint="#FFFFFF"
            app:elevation="4dp" />

        <!-- Guest / Demo Mode Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuestSignIn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="@string/login_as_guest"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/bg_card"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp" />

        <TextView
            android:id="@+id/tvLoginStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="20dp"
            android:text="Mã hóa đầu cuối • Xác thực Google Play Services" />

        <ProgressBar
            android:id="@+id/pbLoginLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/colorPrimaryLight"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
