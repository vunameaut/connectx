<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_card_rounded">

    <!-- Avatar -->
    <TextView
        android:id="@+id/tvReqAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_secondary"
        android:text="U"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tvReqSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nguyễn Văn A"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvReqSenderEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="nguyenvana@gmail.com"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvReqTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:20 hôm nay"
            android:textColor="@color/colorPrimaryLight"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Reject Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRejectRequest"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Từ chối"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/bg_card"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1dp"
            android:paddingHorizontal="10dp"
            android:minWidth="0dp" />

        <!-- Accept Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptRequest"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="Đồng ý"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="18dp"
            app:backgroundTint="@color/colorPrimary"
            android:paddingHorizontal="12dp"
            android:minWidth="0dp" />
    </LinearLayout>

</LinearLayout>
