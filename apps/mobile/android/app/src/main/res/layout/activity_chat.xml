<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root">

    <!-- Chat Header Bar -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@color/bg_dark">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            android:rotation="180"
            app:tint="@color/text_primary"
            android:contentDescription="Quay lại" />

        <!-- Avatar Container with Online Indicator -->
        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/tvChatAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_card_secondary"
                android:text="B"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_status_online" />
        </FrameLayout>

        <!-- Contact Name & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvChatContactName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bạn bè ConnectX"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_verified"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChatContactStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_online"
                android:textColor="@color/status_online"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Voice Call Button -->
        <ImageView
            android:id="@+id/btnChatVoiceCall"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:background="@drawable/bg_card_rounded"
            android:src="@drawable/ic_calls"
            app:tint="@color/status_online"
            android:contentDescription="Gọi thoại" />

        <!-- Video Call Button -->
        <ImageView
            android:id="@+id/btnChatVideoCall"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_card_rounded"
            android:src="@drawable/ic_videocall"
            app:tint="@color/colorPrimaryLight"
            android:contentDescription="Gọi video" />

        <!-- More Menu -->
        <ImageView
            android:id="@+id/btnChatMore"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_muted"
            android:contentDescription="Tùy chọn" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Rich Chat Input Bar (Zalo / Messenger Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="8dp"
        android:paddingHorizontal="10dp"
        android:background="@color/bg_dark">

        <!-- Emoji Button -->
        <ImageView
            android:id="@+id/btnEmoji"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_emoji"
            app:tint="@color/text_secondary"
            android:contentDescription="Emoji" />

        <!-- Attachment / Image Button -->
        <ImageView
            android:id="@+id/btnAttachment"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_image"
            app:tint="@color/text_secondary"
            android:contentDescription="Gửi ảnh" />

        <!-- Input Field Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <EditText
                android:id="@+id/etMessageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/type_message_hint"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:paddingVertical="8dp"
                android:maxLines="4"
                android:inputType="textCapSentences|textMultiLine" />

            <!-- Mic Voice Record Icon inside Input -->
            <ImageView
                android:id="@+id/btnVoiceRecord"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_voice_record"
                app:tint="@color/text_muted"
                android:contentDescription="Ghi âm thoại" />
        </LinearLayout>

        <!-- Send Button with Gradient Accent -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:fabCustomSize="44dp"
            app:srcCompat="@drawable/ic_send"
            app:tint="@color/white"
            app:backgroundTint="@color/colorPrimary"
            app:elevation="3dp"
            android:contentDescription="Gửi tin nhắn" />
    </LinearLayout>

</LinearLayout>
