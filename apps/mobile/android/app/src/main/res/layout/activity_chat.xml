<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Chat App Bar -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/bg_card">

        <!-- Back Button -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_search"
            android:rotation="180"
            app:tint="@color/text_primary"
            android:contentDescription="Quay lại" />

        <!-- Avatar -->
        <TextView
            android:id="@+id/tvChatAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_card_secondary"
            android:text="B"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="4dp" />

        <!-- Contact Name & Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvChatContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn bè ConnectX"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatContactStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_online"
                android:textColor="@color/call_green"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Voice Call Button -->
        <ImageView
            android:id="@+id/btnChatVoiceCall"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_calls"
            app:tint="@color/colorAccent"
            android:contentDescription="Gọi thoại" />

        <!-- Video Call Button -->
        <ImageView
            android:id="@+id/btnChatVideoCall"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_videocall"
            app:tint="@color/colorPrimary"
            android:contentDescription="Gọi video" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Chat Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@color/bg_card">

        <!-- Attachment Button -->
        <ImageView
            android:id="@+id/btnAttachment"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="8dp"
            android:src="@drawable/ic_screenshare"
            app:tint="@color/text_secondary"
            android:contentDescription="Đính kèm" />

        <!-- Input Field -->
        <EditText
            android:id="@+id/etMessageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_input_box"
            android:hint="@string/type_message_hint"
            android:textColorHint="@color/text_muted"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="16dp"
            android:maxLines="4"
            android:inputType="textCapSentences|textMultiLine" />

        <!-- Send Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnSendMessage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:fabCustomSize="44dp"
            app:srcCompat="@drawable/ic_send"
            app:tint="@color/white"
            app:backgroundTint="@color/colorPrimary"
            android:contentDescription="Gửi tin nhắn" />
    </LinearLayout>

</LinearLayout>
