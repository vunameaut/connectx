# Copy this file to "turn.properties" (same folder) and fill in your own TURN relay.
# turn.properties is git-ignored. Without it, calls only work when both phones can reach each
# other directly (same Wi-Fi). Calls over mobile data / different networks need a TURN relay.
#
# Free option: create an account at https://www.metered.ca  -> TURN Server -> Credentials
turn.urls=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
turn.username=YOUR_TURN_USERNAME
turn.credential=YOUR_TURN_CREDENTIAL
