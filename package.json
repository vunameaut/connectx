{
  "name": "connectx",
  "version": "1.0.0",
  "private": true,
  "description": "ConnectX Mobile Communication Platform",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:apk": "pwsh -Command \"cd apps/mobile/android; .\\gradlew.bat assembleDebug\"",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
